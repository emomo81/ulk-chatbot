# OPTIONAL - the chatbot works fully WITHOUT any key (offline knowledge-base mode).
# To enable "AI-enhanced answers", add these in Streamlit Cloud -> App -> Settings -> Secrets.

OPENAI_API_KEY = "sk-..."
LLM_MODEL = "gpt-4o-mini"

# Any OpenAI-compatible provider works, e.g. free Groq:
# OPENAI_API_KEY = "gsk_..."
# OPENAI_BASE_URL = "https://api.groq.com/openai/v1"
# LLM_MODEL = "llama-3.3-70b-versatile"

# Google Gemini:
# OPENAI_API_KEY = "AIza..."
# OPENAI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
# LLM_MODEL = "gemini-2.0-flash"
